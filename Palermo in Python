class Game:
    def __init__(self, players):
        self.players = players
        self.roles = []
        self.night_phase = False
        self.leader_alive = True
        self.max_killers = 5
        self.night_counter = 0

    def assign_roles(self):
        # Ensure only one leader and up to 5 killers
        if "Leader of Killers" not in self.roles:
            self.roles.append("Leader of Killers")
        killers_count = sum(1 for role in self.roles if role == "Killer")
        if killers_count < self.max_killers:
            self.roles.extend(["Killer"] * (self.max_killers - killers_count))

    def check_game_end(self):
        # End the game if all killers and leader are eliminated
        remaining_killers = [player for player in self.players if player.role == "Killer" and player.alive]
        leader_alive = any(player.role == "Leader of Killers" and player.alive for player in self.players)
        if not remaining_killers and not leader_alive:
            print("The game ends. Killers have been defeated!")
            return True
        return False

    def night_actions(self):
        self.night_counter += 1
        killer_targets = []

        # Killers' single action per night regardless of number
        active_killers = [player for player in self.players if player.role == "Killer" and player.alive]
        if active_killers:
            target = self.select_target()
            if target:
                killer_targets.append(target)

        # Leader's additional kill every two nights
        leader = next((player for player in self.players if player.role == "Leader of Killers" and player.alive), None)
        if leader and self.night_counter % 2 == 0:
            leader_target = self.select_target()
            if leader_target:
                killer_targets.append(leader_target)

        # Execute all selected targets
        for target in killer_targets:
            target.alive = False
            print(f"{target.name} was killed during the night.")

        # Check if the game should end
        self.check_game_end()

    def select_target(self):
        # This is a placeholder for selecting a target logic
        alive_players = [player for player in self.players if player.alive]
        if not alive_players:
            return None
        return alive_players[0]  # Simplified for example


class Player:
    def __init__(self, name, role):
        self.name = name
        self.role = role
        self.alive = True
